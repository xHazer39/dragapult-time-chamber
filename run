#!/usr/bin/env bash
# One command: creates .venv on first use, then starts the Chamber. Extra args go to `python -m chamber`.
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv
  .venv/bin/pip install -q -r requirements.txt
fi
exec .venv/bin/python -m chamber "$@"
